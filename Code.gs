function doGet(e){var cb=e.parameter.callback||"callback",key=String(e.parameter.key||"").trim(),out={ok:false};if((e.parameter.action||"")==="load"&&key){var raw=PropertiesService.getScriptProperties().getProperty("biz_"+key);if(raw){var o=JSON.parse(raw);out={ok:true,state:o.state||{},updatedAt:o.updatedAt||0,user:o.user||"Partner"}}else out={ok:true,state:null,updatedAt:0,user:null}}return ContentService.createTextOutput(cb+"("+JSON.stringify(out)+");").setMimeType(ContentService.MimeType.JAVASCRIPT)}function doPost(e){var out={ok:false};try{var b=JSON.parse(e.postData.contents||"{}"),key=String(b.key||"").trim();if(b.action==="save"&&key&&b.state){var p=PropertiesService.getScriptProperties(),old=p.getProperty("biz_"+key),ot=0;if(old){try{ot=Number(JSON.parse(old).updatedAt||0)}catch(x){}}var t=Number(b.updatedAt||Date.now());if(t>=ot)p.setProperty("biz_"+key,JSON.stringify({state:b.state,updatedAt:t,user:String(b.user||"Partner").slice(0,60)}));out={ok:true,updatedAt:Math.max(t,ot)}}}catch(err){out={ok:false,error:String(err)}}return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON)}